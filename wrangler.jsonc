// Cloudflare settings for the Llansannan Community website.
// Values marked CHANGE_ME are filled in during setup (see SETUP.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llansannan-community",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // The website files (homepage, admin area, scripts)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // STAGE 1 (now): the free address https://llansannan-community.llansannancc.workers.dev
  // STAGE 2 (when the domain is confirmed): set workers_dev to false and un-comment "routes" (see SETUP.md).
  "workers_dev": true,
  // "routes": [
  //   { "pattern": "CHANGE_ME.example", "custom_domain": true }
  // ],

  // The events/news database. Created with: npx wrangler d1 create llansannan --jurisdiction eu
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llansannan",
      "database_id": "02d94d4b-b856-4c6c-b10b-d5505d6b6974",
      "migrations_dir": "migrations"
    }
  ],

  // Emails to moderators when something needs approving (Cloudflare Email Sending).
  // STAGE 2: needs the domain, so it's switched off until then. The site works without it.
  // "send_email": [
  //   { "name": "EMAIL" }
  // ],

  // Once a day at 03:15 UTC: remove contact details from events that finished 30+ days ago.
  "triggers": { "crons": ["15 3 * * *"] },

  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://llansannan-community.llansannancc.workers.dev",
    "MAIL_FROM": "notifications@CHANGE_ME.example",
    // The Turnstile "site key" (spam check on the public form). Can be added any time; see SETUP.md.
    "TURNSTILE_SITE_KEY": "",
    // Moderator sign-in: the "Client ID" of the GitHub OAuth app (see SETUP.md). Not secret.
    "GITHUB_CLIENT_ID": "Ov23liJQRS3ADQmNwQ97"
    // Secrets are added in the dashboard (Settings > Variables and Secrets > Add > type "Secret"), never here:
    //   GITHUB_CLIENT_SECRET  from the GitHub OAuth app (see SETUP.md)
    //   TURNSTILE_SECRET      spam check, Stage 2
  },

  "observability": { "enabled": true },

  // Local testing on your own computer: npm run db:local, then npm run dev
  // Open /admin/?as=lead1@example.com to act as anyone from seed/dev-seed.sql.
  "env": {
    "dev": {
      "d1_databases": [
        { "binding": "DB", "database_name": "llansannan", "database_id": "local-dev", "migrations_dir": "migrations" }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        // A pretend GitHub for automated tests (tests/mock-github.mjs)
        "GITHUB_CLIENT_ID": "test-client",
        "GITHUB_CLIENT_SECRET": "test-secret",
        "GITHUB_WEB_URL": "http://127.0.0.1:8788",
        "GITHUB_API_URL": "http://127.0.0.1:8788",
        "SITE_URL": "http://localhost:8787",
        "TURNSTILE_SITE_KEY": ""
      }
    }
  }
}
